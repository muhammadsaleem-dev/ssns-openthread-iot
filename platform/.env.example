# ============================================================
# Root-level environment configuration
# Copy to .env and adjust as needed
# ============================================================

# MongoDB
MONGO_INITDB_DATABASE=ssns_monitoring

# Backend
MONGODB_URI=mongodb://mongodb:27017/ssns_monitoring
MONGODB_DATABASE=ssns_monitoring
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=simulator

# Gateway
BACKEND_URL=http://backend:8080/api/sensor-data
TELEMETRY_INTERVAL=10
NODE_COUNT=4
LOG_LEVEL=INFO
