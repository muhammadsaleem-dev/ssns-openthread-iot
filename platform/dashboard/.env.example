# Backend API base URL (empty for relative path so Nginx and local proxy work automatically)
VITE_API_BASE_URL=

# Data polling interval in milliseconds
VITE_POLL_INTERVAL=10000

# Role-Based Authentication Credentials (Set these securely on your VPS server / build environment)
VITE_ADMIN_USER=your_admin_username
VITE_ADMIN_PASS=your_secure_admin_password
VITE_VISITOR_USER=your_visitor_username
VITE_VISITOR_PASS=your_visitor_password
