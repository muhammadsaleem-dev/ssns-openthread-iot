# ============================================================
# BLE Gateway Simulator — Environment Configuration
# Copy to .env and adjust as needed
# ============================================================

# Backend API endpoint
BACKEND_URL=http://localhost:8080/api/sensor-data

# Gateway mode: "simulator" or "coap"
GATEWAY_MODE=simulator

# Telemetry transmission interval in seconds (used in simulator mode)
TELEMETRY_INTERVAL=10

# Number of simulated sensor nodes
NODE_COUNT=4

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
